# OpenWeather API Key
# Obtain from: https://openweathermap.org/api
# Free tier: 1,000 calls/day
#
# Error Handling & Retry Behavior (Story 2.8):
# - Timeout threshold: 5 seconds (requests exceeding this return 504 timeout error)
# - Retry logic: Single retry attempt for 5xx API server errors with 1-second delay
# - No retries for: 404 (invalid location), timeout, or network errors
# - All errors return consistent JSON format: { error: { code, message } }
# - Error codes: timeout, invalid_location, service_unavailable, network_error, unknown_error
# - Stack traces logged server-side only, never exposed to users
OPENWEATHER_API_KEY=your_api_key_here

# Upstash Redis (for privacy-first analytics logging)
# Obtain from: https://upstash.com/
# Free tier: 256MB storage, 500K commands/month
#
# Vercel Marketplace Integration (Recommended):
# When deploying to Vercel, these variables auto-populate via Vercel Marketplace:
# https://vercel.com/integrations/upstash
#
# For local development, create a free Upstash Redis database and copy credentials here.
# Analytics logging uses fire-and-forget pattern - app works even if Redis is unavailable.
# Analytics failures do not trigger error responses (transparent to users).
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
